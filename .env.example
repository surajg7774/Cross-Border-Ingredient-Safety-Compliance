# Copy this file to .env and fill in real values.
#
# IMPORTANT: Free-tier model availability on Google AI Studio changes
# often. Before filling these in, verify the current free-tier model
# IDs at https://aistudio.google.com/ — do not assume the placeholders
# below are still valid.

GOOGLE_API_KEY=your-google-api-key-here
PRIMARY_MODEL=gemini-model-id-here
SECONDARY_MODEL=gemini-model-id-here
EMBEDDING_MODEL=gemini-embedding-001

# Optional: which text-generation backend src/report/narrator.py uses --
# "native" (google-genai directly) or "langchain" (ChatGoogleGenerativeAI).
# Defaults to "native" -- current behaviour is what runs unless you opt in.
# See src/text_generation.py's module docstring for what "langchain" cannot
# reproduce (e.g. prompt_feedback in the rare zero-candidates case).
# MODEL_BACKEND=native

# Optional: which store the category-classification stage searches through
# -- "numpy" (default, exhaustive cosine similarity) or "chroma" (a
# persisted index built from the SAME cached embeddings, at zero extra API
# cost, and measured to return identical rankings to numpy -- see
# docs/findings.md F-11/F-20).
# RETRIEVAL_STORE=numpy

# Optional: the report screen's "email this report" feature
# (src/report/email.py). Server-side SMTP only -- there is no UI form for
# these, so nobody using the app types credentials. Leave unset to disable
# the feature entirely: the whole "Email this report" section is hidden
# and only the JSON/CSV/PDF downloads render. All five must be set
# together, or the section stays hidden.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=reports@example.com

# Optional: powers the two retrieval-backed horizon news lanes (per-
# additive news, and India -> EU route news for the confirmed food
# category) via Tavily search (src/horizon/search.py) -- free tier, 1,000
# credits/month, no card required. Both lanes are ADVISORY ONLY: they can
# never change the compliance verdict. Leave unset to disable both --
# get_search_provider() returns None (not a fixture, not a silent
# no-op), both lanes degrade to empty results, and everything else in the
# app works unaffected.
# TAVILY_API_KEY=your-tavily-api-key-here
