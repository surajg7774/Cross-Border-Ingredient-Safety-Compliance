        <mxCell id="n5a" value="substitutes_node&#10;find_substitutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#148F77;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="615" width="180" height="50" as="geometry" />
