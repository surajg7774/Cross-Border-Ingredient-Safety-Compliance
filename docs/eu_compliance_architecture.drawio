          <mxGeometry x="560" y="615" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="parlbl" value="parallel branches" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1">
