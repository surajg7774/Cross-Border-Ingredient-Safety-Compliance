          <mxGeometry x="380" y="425" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="hum" value="human picks&#10;a category" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="425" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="Command(resume=…)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#B7950B;fontSize=10;" edge="1" parent="1" source="hum" target="conf">
          <mxGeometry relative="1" as="geometry" />
