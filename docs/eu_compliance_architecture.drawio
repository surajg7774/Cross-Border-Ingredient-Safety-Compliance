        <mxCell id="lgnote" value="WHY LANGGRAPH&#10;&#10;Category recall@1 = 0.53. Twenty-plus retrieval configurations were&#10;measured and none improved it, so human confirmation is a design&#10;requirement, not a fallback.&#10;&#10;interrupt() replaces hand-rolled pause/resume that previously existed&#10;twice: a --category CLI flag applied AFTER a wrong verdict, and&#10;Streamlit session-state with a stage marker and a full script rerun.&#10;&#10;It fires PER COMPONENT — two independent pauses on a composite label,&#10;each separately resumable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDFEFE;strokeColor=#999999;align=left;fontSize=10;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="290" height="200" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Data shapes" id="datashapes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dtitle" value="Data shape at each stage boundary" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dsub" value="Nothing is copied forward. Each stage adds a NEW record keyed on item_id, so adding a field upstream cannot break downstream." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="ExtractedItem  —  what is PRINTED&#10;&#10;item_id            10&#10;position           7&#10;nesting_depth      0&#10;parent_item_id     null&#10;verbatim           &quot;1101 ( ii )&quot;&#10;name_as_declared   null&#10;declared_role      &quot;FLOUR TREATMENT AGENT&quot;&#10;role_source        &quot;group_heading&quot;&#10;declared_code      &quot;1101 ( ii )&quot;&#10;code_system        &quot;bare&quot;&#10;percentage         null&#10;emphasis           false&#10;footnote_marker    null&#10;confidence         1.0&#10;&#10;NO is_additive. NO canonical id.&#10;Observations only." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#7D3C98;align=left;fontSize=10;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="330" height="290" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="ResolvedItem  —  what it IS&#10;&#10;item_id                 10   ← the only link back&#10;canonical_ins           &quot;1101(ii)&quot;&#10;eu_canonical_id         null&#10;classification          &quot;enzyme&quot;&#10;normalised_role         &quot;Flour treatment agent&quot;&#10;codex_functional_classes [&quot;Flavour enhancer&quot;]&#10;resolution_method       &quot;code_exact&quot;&#10;resolution_confidence   0.98&#10;flags                   [&quot;role_class_mismatch&quot;]&#10;candidates              []&#10;matched_on              &quot;1101(ii)&quot;&#10;&#10;Reads only 5 of the 14 fields above:&#10;item_id, declared_code, name_as_declared,&#10;declared_role, verbatim" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#148F77;align=left;fontSize=10;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="360" height="290" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="ItemVerdict  —  what the LAW says&#10;&#10;item_id            10&#10;eu_canonical_id    null&#10;additive_name      &quot;Papain&quot;&#10;component_label    null&#10;headline           &quot;out_of_scope&quot;&#10;verdict_certainty  &quot;certain&quot;&#10;category_sensitive false&#10;by_category        []&#10;flags              [&quot;enzyme_reg_1332_2008&quot;]&#10;&#10;by_category holds ONE CategoryVerdict&#10;per candidate category:&#10;  fcs_code, rank, verdict, max_level,&#10;  conditions, source_url, retrieved_date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D1F2EB;strokeColor=#148F77;align=left;fontSize=10;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="100" width="360" height="290" as="geometry" />
        </mxCell>

        <mxCell id="de1" value="item_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" value="item_id" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="funnel" value="THE FUNNEL NARROWS&#10;&#10;14 fields written by extraction&#10;→ 5 read by the resolver&#10;→ 3 read by the category stage&#10;&#10;Each stage consumes less than the last.&#10;That is why the boundaries hold." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDFEFE;strokeColor=#999999;align=left;fontSize=11;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="330" height="140" as="geometry" />
        </mxCell>

        <mxCell id="worked" value="WORKED EXAMPLE — Parle-G, INS 1101(ii)&#10;&#10;label prints        &quot;FLOUR TREATMENT AGENT [1101 ( ii )]&quot;&#10;extraction records  declared_code &quot;1101 ( ii )&quot;, code_system &quot;bare&quot;&#10;resolver normalises &quot;1101(ii)&quot;, finds it in codex_ins as PAPAIN&#10;                    Codex says Flavour enhancer — the label says&#10;                    Flour treatment agent → flag role_class_mismatch&#10;                    absent from eu_fip → classification &quot;enzyme&quot;&#10;rule engine         out_of_scope — Reg 1332/2008 governs enzymes,&#10;                    NOT Annex II&#10;&#10;A naive closed-list check would have said &quot;not in the Union list,&#10;therefore not permitted&quot; and produced a FALSE export failure on a&#10;perfectly legal product." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#B7950B;align=left;fontSize=10;fontFamily=Courier New;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="430" width="750" height="230" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
