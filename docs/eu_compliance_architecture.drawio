        </mxCell>
        <mxCell id="lgsub" value="Drives both scripts/run_pipeline.py and app.py.  Nodes call the same pure functions the standalone scripts call." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="800" height="20" as="geometry" />
        </mxCell>

