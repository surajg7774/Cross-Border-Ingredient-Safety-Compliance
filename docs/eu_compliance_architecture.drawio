          <mxGeometry x="380" y="305" width="240" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="classify_node&#10;product" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#7D3C98;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="335" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="classify_node&#10;component A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#7D3C98;fontSize=11;" vertex="1" parent="1">
